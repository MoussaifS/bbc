{
  "kind": "collectionType",
  "collectionName": "customers",
  "info": {
    "singularName": "customer",
    "pluralName": "customers",
    "displayName": "customer"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "bookings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::booking.booking",
      "mappedBy": "customer"
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "phoneNumber": {
      "type": "string",
      "required": true
    },
    "notes": {
      "type": "text"
    }
  }
}
