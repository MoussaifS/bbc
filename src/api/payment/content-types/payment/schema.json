{
  "kind": "collectionType",
  "collectionName": "payments",
  "info": {
    "singularName": "payment",
    "pluralName": "payments",
    "displayName": "payment",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "amount": {
      "type": "decimal",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "pending",
      "required": true
    },
    "paymentMethod": {
      "type": "string",
      "required": true
    },
    "transactionId": {
      "type": "string",
      "unique": true
    },
    "transactionData": {
      "type": "json"
    },
    "booking": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::booking.booking",
      "inversedBy": "payment"
    }
  }
}
